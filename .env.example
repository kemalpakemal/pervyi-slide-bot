BOT_TOKEN=
ADMIN_ID=
DATABASE_URL=sqlite+aiosqlite:///./card_studio.db
STORAGE_PATH=./data
MAX_FILE_MB=15
MAX_FILES_PER_ORDER=12

# OpenAI GPT Image 2.6
OPENAI_API_KEY=
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_COMPLEXITY=medium

# Product cutout and export
REMOVE_BG_MODEL=u2netp
OUTPUT_WIDTH=1200
OUTPUT_HEIGHT=1600
DEMO_LONG_EDGE=700
DEMO_WATERMARK_TEXT=ПЕРВЫЙ СЛАЙД • ДЕМО
MAX_GENERATION_SLIDES=10
