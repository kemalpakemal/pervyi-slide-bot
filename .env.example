# Обязательные
BOT_TOKEN=
ADMIN_ID=
# Railway: ${{Postgres.DATABASE_URL}}. Форматы postgres:// и postgresql:// принимаются.
DATABASE_URL=sqlite+aiosqlite:///./card_studio.db
# На Railway: /data (путь монтирования Volume)
STORAGE_PATH=./data
MAX_FILE_MB=15
MAX_FILES_PER_ORDER=12

# Опционально (на этапе 1 только отображаются в /health)
ENABLE_LEAD_RADAR=false
IMAGE_PROVIDER=
LLM_PROVIDER=
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
