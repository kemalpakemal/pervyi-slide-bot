BOT_TOKEN=
ADMIN_ID=
DATABASE_URL=sqlite+aiosqlite:///./card_studio.db
STORAGE_PATH=./data
MAX_FILE_MB=15
MAX_FILES_PER_ORDER=12

# Hybrid image generation
IMAGE_MODE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
GENERATION_TIMEOUT_SECONDS=180
MAX_GENERATION_SLIDES=10
MAX_ORDER_COST_USD=5.00
# Conservative budget reservation per generated image (two variants per slide)
ESTIMATED_IMAGE_COST_USD=0.25
TEXT_OVERLAY_ENABLED=false

DEMO_LONG_EDGE=700
DEMO_WATERMARK_TEXT=ПЕРВЫЙ СЛАЙД • ДЕМО

# Optional privacy-safe product analytics (server-side only)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
