BOT_TOKEN=
ADMIN_ID=
DATABASE_URL=sqlite+aiosqlite:///./card_studio.db
STORAGE_PATH=./data
MAX_FILE_MB=15
MAX_FILES_PER_ORDER=12

# OctavApi image generation
IMAGE_PROVIDER=octavapi
OCTAVAPI_API_KEY=
OCTAVAPI_BASE_URL=https://octavapi.shop/v1
OCTAVAPI_IMAGE_MODEL=image_gen
OCTAVAPI_IMAGE_SIZE=1024x1024

# Product cutout and export
REMOVE_BG_MODEL=u2netp
OUTPUT_WIDTH=1200
OUTPUT_HEIGHT=1600
DEMO_LONG_EDGE=700
DEMO_WATERMARK_TEXT=ПЕРВЫЙ СЛАЙД • ДЕМО
MAX_GENERATION_SLIDES=10
